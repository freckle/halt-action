{
  "name": "halt",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Halt and un-halt open PRs by committing a file to your repository",
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && ncc build lib/main.js --minify",
    "format": "prettier --write \"**/*.ts\"",
    "format-check": "prettier --check \"**/*.ts\"",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint",
    "knip": "knip"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/freckle/halt-action.git"
  },
  "author": "Renaissance Learning Inc",
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/exec": "^3.0.0",
    "@actions/github": "^9.1.1",
    "@slack/webhook": "^8.1.0"
  },
  "devDependencies": {
    "@freckle/eslint-config": "^1.3.6",
    "@freckle/prettier-config": "^1.3.6",
    "@freckle/tsconfig": "^1.3.6",
    "@octokit/plugin-rest-endpoint-methods": "^18.0.0",
    "@types/node": "^26.6.11",
    "@vercel/ncc": "^0.45.0",
    "@vitest/coverage-v8": "^5.1.1",
    "eslint": "^10.15.0",
    "knip": "^6.48.0",
    "prettier": "^3.10.1",
    "typescript": "^6.0.3",
    "vitest": "^5.1.1"
  },
  "packageManager": "pnpm@12.23.0+sha512.02da94ffaf133f46074322afe552f90d40b5f71ae259aefbccdacc5085b1d617e98d65e0131f5748b9b67445978ee5055d7d59a473f1eef0d504854fefcd5975",
  "prettier": "@freckle/prettier-config"
}
