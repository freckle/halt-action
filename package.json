{
  "name": "halt",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Halt and un-halt open PRs by committing a file to your repository",
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && ncc build lib/main.js --minify",
    "format": "prettier --write \"**/*.ts\"",
    "format-check": "prettier --check \"**/*.ts\"",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint",
    "knip": "knip"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/freckle/halt-action.git"
  },
  "author": "Renaissance Learning Inc",
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/exec": "^3.0.0",
    "@actions/github": "^9.1.1",
    "@slack/webhook": "^8.1.0"
  },
  "devDependencies": {
    "@freckle/eslint-config": "^1.3.5",
    "@freckle/prettier-config": "^1.3.5",
    "@freckle/tsconfig": "^1.3.4",
    "@octokit/plugin-rest-endpoint-methods": "^18.0.0",
    "@types/node": "^26.6.6",
    "@vercel/ncc": "^0.45.0",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.15.0",
    "knip": "^6.45.1",
    "prettier": "^3.10.1",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@12.21.0+sha512.66fd8278ee28935ce951792d34367ff3af5c432a2756445823029533835b8da529bbe0be5130afd56ed0713fb8789e47bad82d93bd5ae2fe54b15562d6276ef0",
  "prettier": "@freckle/prettier-config"
}
