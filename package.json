{
  "name": "halt",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Halt and un-halt open PRs by committing a file to your repository",
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && ncc build lib/main.js --minify",
    "format": "prettier --write \"**/*.ts\"",
    "format-check": "prettier --check \"**/*.ts\"",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint",
    "knip": "knip"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/freckle/halt-action.git"
  },
  "author": "Renaissance Learning Inc",
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/exec": "^3.0.0",
    "@actions/github": "^9.1.1",
    "@slack/webhook": "^8.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@octokit/types": "^17.0.0",
    "@types/node": "^24.13.4",
    "@vercel/ncc": "^0.45.0",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^10.10.0",
    "knip": "^6.34.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^5.0.0"
  },
  "packageManager": "pnpm@12.4.1+sha512.2e81e399d73fe8390dab25e06aa788ab7a5908248d2f5a370f82b481147a6a7a367bf8048f9a6fdb6460f21a66f0542dedb8b94ca2c8723596741920b1656d4c"
}
